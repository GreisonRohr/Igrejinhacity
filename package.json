{
  "name": "igrejinha-city",
  "version": "1.0.0",
  "description": "Jogo 3D de mundo aberto de Igrejinha-RS no navegador",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "data:terrain": "node scripts/fetch-terrain.mjs",
    "data:osm": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/fetch-osm.mjs",
    "data:preview": "node scripts/preview.mjs",
    "data:world": "node scripts/build-world.mjs && node scripts/build-nav.mjs",
    "data:nav": "node scripts/build-nav.mjs",
    "data:geo": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/fetch-geo-igrejinha.mjs",
    "test": "node tests/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GreisonRohr/Igrejinhacity.git"
  },
