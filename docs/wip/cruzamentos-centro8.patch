+      const a = c.inner[i], b = c.inner[i + 1], mx = (a[0] + b[0]) / 2 - J.x, mz = (a[1] + b[1]) / 2 - J.z;
+      let nx = -(b[1] - a[1]), nz = b[0] - a[0]; if (nx * mx + nz * mz > 0) { nx = -nx; nz = -nz; }
