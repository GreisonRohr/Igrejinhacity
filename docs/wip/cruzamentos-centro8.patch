+    if (!fillPoly) continue;
+    if (c.fill) {
+      const tr = THREE.ShapeUtils.triangulateShape(c.fill.map(p => new THREE.Vector2(p[0], p[1])), []);
+      for (const [i, j, k] of tr) { const a = c.fill[i], b = c.fill[j], d = c.fill[k]; top.tri(Y(a, 0.08 + curbH), Y(b, 0.08 + curbH), Y(d, 0.08 + curbH), [uv(a, s), uv(b, s), uv(d, s)], col, 0, up); }
+    } else for (let i = 0; i < c.inner.length - 1; i++) {
+      const a = c.inner[i], b = c.inner[i + 1], b2 = c.ring[i + 1], a2 = c.ring[i];
+      top.quad(Y(a, 0.08 + curbH), Y(b, 0.08 + curbH), Y(b2, 0.08 + curbH), Y(a2, 0.08 + curbH), [uv(a, s), uv(b, s), uv(b2, s), uv(a2, s)], col, 0, up);
+    }
+    // meio-fio ao longo da borda curva, virado para o asfalto
